{
  "name": "@gymolingo/core",
  "version": "0.1.0",
  "private": true,
  "description": "Pure TypeScript domain logic: nutrition targets, progression, streaks, gamification, reminders, coach statistics.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:edge": "esbuild src/index.ts --bundle --format=esm --platform=neutral --outfile=../../supabase/functions/_shared/core.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "~5.9.0",
    "vitest": "^3.2.0"
  }
}
